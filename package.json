{
  "name": "kagaribi-monorepo",
  "private": true,
  "description": "A Hono-based microservices management framework",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "release": "pnpm build && pnpm -r publish --access public --no-git-checks"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
