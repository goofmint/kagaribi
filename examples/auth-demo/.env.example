# JWT Secret for signing tokens (REQUIRED)
# This is used to sign and verify JWT tokens for authentication
JWT_SECRET=your-secret-key-change-this-in-production

# Shared secret for Kagaribi context propagation (REQUIRED)
# This is used to sign context headers when deploying packages separately
SHARED_SECRET=your-shared-secret-change-this-in-production

# Production environment URLs (optional, for separated deployment)
# Uncomment and set these when deploying to production with separated packages
# AUTH_SERVICE_URL=https://auth.example.com
# PROTECTED_API_URL=https://api.example.com
